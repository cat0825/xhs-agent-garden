{%if settings.dgHomeLink === true%}
    <nav class="navbar">
        <div class="navbar-inner">
            <a href="/" class="site-brand">
                {% if meta.siteLogoPath %}
                    <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{meta.siteName}}">
                {% else %}
                    <span class="site-brand-mark">E</span>
                    <span class="site-brand-text">{{meta.siteName}}</span>
                {% endif %}
            </a>
            <div class="nav-links">
                <a href="/notes/inbox" class="nav-link"><i data-lucide="inbox"></i><span>Inbox</span></a>
                <a href="/notes/notes" class="nav-link"><i data-lucide="book-open"></i><span>Notes</span></a>
                <a href="/notes/ideas" class="nav-link"><i data-lucide="lightbulb"></i><span>Ideas</span></a>
                <a href="/notes/projects" class="nav-link"><i data-lucide="briefcase"></i><span>Projects</span></a>
            </div>
        </div>
        <div class="navbar-actions">
        {% if settings.dgEnableSearch === true%}
            {% include "components/searchButton.njk" %}
        {%endif%}
            {% include "components/themeToggle.njk" %}
        </div>
    </nav>
    {%else%}
    <div class="empty-navbar" >
        <div class="navbar-actions">
        {% if settings.dgEnableSearch === true%}
            {% include "components/searchButton.njk" %}
        {%endif%}
            {% include "components/themeToggle.njk" %}
        </div>
    </div>
{%endif%}
