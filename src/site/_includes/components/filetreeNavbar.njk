<nav class="navbar">
    <div class="navbar-inner">
        <button class="mobile-menu-button" type="button" @click="showFilesMobile=!showFilesMobile" aria-label="打开导航">
            <i data-lucide="menu"></i>
        </button>
        {% for imp in dynamics.filetree.beforeTitle %}
            {% include imp %}
        {% endfor %}
        {% if meta.siteLogoPath %}
        <a href="/" class="site-brand mobile-brand">
                <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{meta.siteName}}">
        </a>
        {% else %}
        <a href="/" class="site-brand mobile-brand">
                <span class="site-brand-mark">E</span>
                <span class="site-brand-text">{{meta.siteName}}</span>
        </a>
        {% endif %}
        {% for imp in dynamics.filetree.afterTitle %}
            {% include imp %}
        {% endfor %}
    </div>

    <div class="navbar-actions">
    {% if settings.dgEnableSearch === true%}
        {% include "components/searchButton.njk" %}
    {%endif%}
        {% include "components/themeToggle.njk" %}
    </div>
</nav>
